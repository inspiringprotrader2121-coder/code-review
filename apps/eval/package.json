{
  "name": "@orvex-review/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "orvex-eval": "./dist/run.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "eval": "node --enable-source-maps dist/run.js",
    "bench": "node --enable-source-maps dist/bench/bench.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "@orvex-review/github": "workspace:*",
    "@orvex-review/review": "workspace:*",
    "@orvex-review/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
