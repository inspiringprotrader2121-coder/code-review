{
  "name": "@orvex-review/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./queue-runner": "./src/queue-runner.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@orvex-review/github": "workspace:*",
    "@orvex-review/queue": "workspace:*",
    "@orvex-review/review": "workspace:*",
    "@orvex-review/rules": "workspace:*",
    "@orvex-review/store": "workspace:*",
    "@orvex-review/tenants": "workspace:*",
    "dotenv": "^16.5.0",
    "hono": "^4.7.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "otplib": "^13.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
