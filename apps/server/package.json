{
  "name": "@orvex-review/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./app": "./dist/app.js",
    "./worker": "./dist/worker.js",
    "./queue-runner": "./dist/queue-runner.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "start:api": "ORVEX_PROCESS_ROLE=api node --enable-source-maps dist/index.js",
    "start:worker": "ORVEX_PROCESS_ROLE=worker node --enable-source-maps dist/index.js",
    "start:scheduler": "ORVEX_PROCESS_ROLE=scheduler node --enable-source-maps dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@orvex-review/config": "workspace:*",
    "@orvex-review/billing": "workspace:*",
    "@orvex-review/github": "workspace:*",
    "@orvex-review/queue": "workspace:*",
    "@orvex-review/review": "workspace:*",
    "@orvex-review/rules": "workspace:*",
    "@orvex-review/store": "workspace:*",
    "@orvex-review/tenants": "workspace:*",
    "dotenv": "^16.5.0",
    "hono": "^4.7.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "otplib": "^13.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
