# Reference configuration for an external Nginx reverse proxy. Replace the
# internal names and TLS settings before use; this file contains no production
# hostname, certificate, or credential.
#
# A managed load balancer should actively health-check each API instance at
# GET /traffic-ready and accept only HTTP 200. Nginx Open Source applies the
# passive max_fails/fail_timeout handling below; it does not provide active
# upstream probing by itself.
#
# Set ORVEX_TRUSTED_PROXY_IPS on each API process to this proxy's exact socket
# address(es). The application otherwise ignores X-Forwarded-For and X-Real-IP
# so an arbitrary client cannot choose its rate-limit identity.

upstream orvex_api {
    least_conn;
    server api-1.internal:8788 max_fails=3 fail_timeout=10s;
    server api-2.internal:8788 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 80;
    server_name _;

    # Configure TLS at this edge or at the provider load balancer. Do not use
    # this template to terminate production TLS without certificates in the
    # server's protected configuration.

    location = /health {
        proxy_pass http://orvex_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /traffic-ready {
        proxy_pass http://orvex_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://orvex_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
}
