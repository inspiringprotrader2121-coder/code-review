{
  "name": "orvex-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm --filter @orvex-review/server dev",
    "build": "pnpm clean && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:config": "node scripts/check-config-schema.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:docs": "pnpm check:config && node scripts/check-doc-links.mjs",
    "check:env": "node scripts/check-env-access.mjs",
    "check:exports": "node scripts/check-built-exports.mjs",
    "check:built-exports": "node scripts/check-built-exports.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "coverage:check": "node scripts/coverage-trend.mjs --require-baseline",
    "coverage:report": "node scripts/coverage-trend.mjs --report",
    "verify:linux-fresh": "bash scripts/verify-linux-fresh.sh",
    "test": "pnpm -r test && node --test scripts/*.test.mjs && bash scripts/deploy-safe.test.sh",
    "review": "pnpm build && pnpm --filter @orvex-review/cli review --",
    "start": "corepack pnpm@11.7.0 --pm-on-fail=ignore --filter @orvex-review/server start",
    "eval": "pnpm build && pnpm --filter @orvex-review/eval eval"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@openai/codex": "0.147.0"
  }
}
