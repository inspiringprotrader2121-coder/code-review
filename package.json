{
  "name": "orvex-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @orvex-review/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs && bash scripts/deploy-safe.test.sh",
    "review": "tsx apps/cli/src/review.ts",
    "start": "corepack pnpm@11.7.0 --pm-on-fail=ignore --filter @orvex-review/server start",
    "eval": "pnpm --filter @orvex-review/eval eval"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@openai/codex": "0.147.0"
  }
}
