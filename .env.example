ORVEX_STANDARD_MODEL=MiniMax-M3
# Active standard reviewer transport compatibility setting.
# Type: enum. Range/default: anthropic. Redaction: none.
ORVEX_STANDARD_API=anthropic
# DeepSeek v4 Pro/Flash shared API key.
