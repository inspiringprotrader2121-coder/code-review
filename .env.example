# Generated from packages/config/configuration-schema.json. Do not edit manually.
# This file contains safe examples only. Put production values in the immutable server environment file; never commit secrets.

# --- Platform ---
# One GitHub App serves all customers; each customer installs it on its organisation.
# GitHub App identifier.
# Type: string. Range/default: GitHub App numeric ID. Redaction: none.
GITHUB_APP_ID=
# Path to the GitHub App private key. Keep the key outside source control.
# Type: path. Range/default: readable PEM path. Redaction: path.
GITHUB_APP_PRIVATE_KEY_PATH=./orvex-review.pem
# Inline GitHub App private key compatibility option. Prefer GITHUB_APP_PRIVATE_KEY_PATH.
# Type: string. Range/default: PEM value. Redaction: secret.
# GITHUB_APP_PRIVATE_KEY=
# GitHub webhook signing secret; also a legacy local-only PLATFORM_SECRET fallback.
# Type: string. Range/default: GitHub webhook signing secret. Redaction: secret.
GITHUB_WEBHOOK_SECRET=
# How long a processed GitHub body hash blocks rotated-delivery replay. Delivery-ID dedupe remains permanent until normal retention.
# Type: integer. Range/default: 1..604800000 ms; default 7200000. Redaction: none.
# ORVEX_WEBHOOK_BODY_DEDUP_TTL_MS=7200000
# GitHub App slug used by install and OAuth flows.
# Type: string. Range/default: GitHub App slug; default orvex-review. Redaction: none.
GITHUB_APP_SLUG=orvex-review
# GitHub bot login used to identify Orvex comments.
# Type: string. Range/default: GitHub login; default orvex-review[bot]. Redaction: none.
GITHUB_APP_BOT_LOGIN=orvex-review[bot]
# Allow unsigned GitHub webhooks only for controlled local development.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_ALLOW_UNSIGNED_WEBHOOKS=1
# Legacy single-repository development mode. Do not set for SaaS.
# Type: owner/repository. Range/default: optional single repository. Redaction: none.
# GITHUB_ALLOWED_REPO=Velatrixcloud/Velatrix-Cloud
# High-entropy signing key for sessions, OAuth state, CSRF, and MFA. It is mandatory for production and explicit public binds; GITHUB_WEBHOOK_SECRET is only a local compatibility fallback.
# Type: string. Range/default: at least 32 UTF-8 bytes in production or public binds. Redaction: secret.
PLATFORM_SECRET=
# Public service URL for callbacks and the connect UI.
# Type: URL. Range/default: absolute public URL. Redaction: none.
APP_URL=http://localhost:8787
# HTTP listening port.
# Type: integer. Range/default: 1..65535; default 8787. Redaction: none.
PORT=8787
# HTTP listening host. Use a public bind only with a high-entropy PLATFORM_SECRET.
# Type: string. Range/default: host/IP; default 127.0.0.1. Redaction: none.
HOST=127.0.0.1
# Node runtime environment. Production selects durable queue/storage safeguards.
# Type: enum. Range/default: production or development. Redaction: none.
# NODE_ENV=
# Compatibility production-mode selector.
# Type: enum. Range/default: production or development. Redaction: none.
# ORVEX_ENV=production
# Comma-separated workspaces allowed to view internal LLM spend. Empty hides it from every tenant.
# Type: csv. Range/default: workspace slugs. Redaction: none.
ORVEX_LLM_COST_VISIBLE_TENANTS=

# --- Identity and browser security ---
# Email/password authentication is always available; GitHub and Google are optional account-linking providers.
# GitHub OAuth client ID. Callback is {APP_URL}/auth/oauth/callback.
# Type: string. Range/default: OAuth client ID. Redaction: none.
GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth client secret.
# Type: string. Range/default: OAuth client secret. Redaction: secret.
GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth web-client ID. Redirect URI is {APP_URL}/auth/google/callback.
# Type: string. Range/default: OAuth client ID. Redaction: none.
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client secret.
# Type: string. Range/default: OAuth client secret. Redaction: secret.
GOOGLE_OAUTH_CLIENT_SECRET=
# Local development only: bypass OAuth and sign in as a fake development user.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# AUTH_DISABLED=1
# Allow public no-login operation where the server explicitly supports it.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_ALLOW_PUBLIC_NOLOGIN=1
# Require an authenticated account for supported product flows.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_REQUIRE_LOGIN=1
# Explicit reverse-proxy socket addresses allowed to supply X-Real-IP and X-Forwarded-For. Leave empty unless the proxy is known and controlled.
# Type: csv. Range/default: exact socket peer IP addresses; default empty. Redaction: none.
# ORVEX_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Default tenant plan for newly created tenant records.
# Type: plan. Range/default: known plan ID; default free. Redaction: none.
# ORVEX_DEFAULT_PLAN=free
# Additional email domains rejected during registration.
# Type: csv. Range/default: lowercase domains. Redaction: none.
# ORVEX_EXTRA_DISPOSABLE_DOMAINS=
# Daily account-creation cap per IP address.
# Type: integer. Range/default: 1..10000; default 5. Redaction: none.
# ORVEX_IP_MAX_ACCOUNTS_PER_DAY=5
# Disable IP abuse blocking only for controlled local diagnostics.
# Type: boolean. Range/default: 0 disables; default enabled. Redaction: none.
# ORVEX_IP_ABUSE_BLOCK=0
# Registration rate-limit window.
# Type: integer. Range/default: 1000..86400000 ms; default 3600000. Redaction: none.
# ORVEX_REGISTER_RATE_WINDOW_MS=3600000
# Maximum registrations per IP per window.
# Type: integer. Range/default: 1..10000; default 10. Redaction: none.
# ORVEX_REGISTER_RATE_IP_MAX=10
# Maximum registrations per email per window.
# Type: integer. Range/default: 1..10000; default 3. Redaction: none.
# ORVEX_REGISTER_RATE_EMAIL_MAX=3
# Login rate-limit window.
# Type: integer. Range/default: 1000..86400000 ms; default 900000. Redaction: none.
# ORVEX_LOGIN_RATE_WINDOW_MS=900000
# Maximum login attempts per IP per window.
# Type: integer. Range/default: 1..10000; default 20. Redaction: none.
# ORVEX_LOGIN_RATE_IP_MAX=20
# Maximum login attempts per account per window.
# Type: integer. Range/default: 1..10000; default 5. Redaction: none.
# ORVEX_LOGIN_RATE_ACCOUNT_MAX=5
# MFA rate-limit window.
# Type: integer. Range/default: 1000..86400000 ms; default 600000. Redaction: none.
# ORVEX_MFA_RATE_WINDOW_MS=600000
# Maximum MFA attempts per IP per window.
# Type: integer. Range/default: 1..10000; default 20. Redaction: none.
# ORVEX_MFA_RATE_IP_MAX=20
# Maximum MFA attempts per account per window.
# Type: integer. Range/default: 1..10000; default 5. Redaction: none.
# ORVEX_MFA_RATE_MAX=5

# --- Stripe billing ---
# Stripe controls subscriptions and prepaid credit purchase. Prices are deployment configuration, not plan semantics.
# Stripe server API key.
# Type: string. Range/default: Stripe secret key. Redaction: secret.
STRIPE_SECRET_KEY=
# Stripe publishable key for browser-facing payment configuration.
# Type: string. Range/default: Stripe publishable key. Redaction: none.
STRIPE_PUBLISHABLE_KEY=
# Primary Stripe webhook signing secret.
# Type: string. Range/default: Stripe signing secret. Redaction: secret.
STRIPE_WEBHOOK_SECRET=
# Secondary Stripe webhook signing secret during key rotation.
# Type: string. Range/default: Stripe signing secret. Redaction: secret.
# STRIPE_WEBHOOK_SECRET_2=
# Accepted Stripe webhook timestamp tolerance.
# Type: integer. Range/default: 0..3600 seconds; default 300. Redaction: none.
# STRIPE_WEBHOOK_TOLERANCE_S=300
# Starter subscription price: 100 included reviews then prepaid $0.50 overage, hard ceiling 1000.
# Type: string. Range/default: Stripe recurring price ID. Redaction: none.
STRIPE_PRICE_REVIEW=
# Pro subscription price: 500 reviews per month, hard cap, no prepaid overage.
# Type: string. Range/default: Stripe recurring price ID. Redaction: none.
STRIPE_PRICE_REVIEW_PLUS=
# Verify Lite subscription price: 50 included reviews then prepaid $0.75 overage, hard ceiling 500.
# Type: string. Range/default: Stripe recurring price ID. Redaction: none.
STRIPE_PRICE_VERIFY_LITE=
# Verify subscription price: 120 included reviews then prepaid $0.75 overage, hard ceiling 1000.
# Type: string. Range/default: Stripe recurring price ID. Redaction: none.
STRIPE_PRICE_VERIFY=
# Legacy metered billing name. Prepaid wallet billing is the normal path.
# Type: string. Range/default: Stripe meter event name. Redaction: none.
# STRIPE_METER_EVENT_REVIEW=orvex_review_overage
# Legacy Verify Lite metered billing name.
# Type: string. Range/default: Stripe meter event name. Redaction: none.
# STRIPE_METER_EVENT_VERIFY_LITE=orvex_verify_lite_overage
# Legacy Verify metered billing name.
# Type: string. Range/default: Stripe meter event name. Redaction: none.
# STRIPE_METER_EVENT_VERIFY=orvex_verify_overage
# Prepaid credit-pack sizes offered in the dashboard.
# Type: csv-integers. Range/default: 100..1000000 cents; default 1000,2500,5000,10000. Redaction: none.
ORVEX_CREDIT_PACKS_CENTS=1000,2500,5000,10000
# Checkout rate-limit window.
# Type: integer. Range/default: 1000..86400000 ms; default 600000. Redaction: none.
# ORVEX_CHECKOUT_RATE_WINDOW_MS=600000
# Maximum checkout starts per rate-limit window.
# Type: integer. Range/default: 1..10000; default 12. Redaction: none.
# ORVEX_CHECKOUT_RATE_MAX=12

