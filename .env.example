# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# MiniMax platform API key.
# Type: string. Range/default: provider API key. Redaction: secret.
MINIMAX_API_KEY=
# MiniMax Anthropic-compatible streaming API URL.
# Type: URL. Range/default: Anthropic-compatible API URL. Redaction: none.
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MiniMax model identifier.
# Type: string. Range/default: provider model ID. Redaction: none.
MINIMAX_MODEL=MiniMax-M3
# MiniMax transport shape; reasoning blocks are preserved.
# Type: enum. Range/default: anthropic. Redaction: none.
MINIMAX_API=anthropic
