# GitHub App (Velatrix Review)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./velatrix-review.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_BOT_LOGIN=velatrix-review[bot]

# Optional: restrict to one repo (owner/repo)
GITHUB_ALLOWED_REPO=Velatrixcloud/Velatrix-Cloud

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
PORT=8787
HOST=0.0.0.0

# Queue: memory (default) or redis
QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Review limits
MAX_FILE_BYTES=120000
MAX_FILES=40
MAX_LLM_TOKENS=50000

# Manual /review endpoint (set in prod)
REVIEW_API_SECRET=
