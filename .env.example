# ——— Platform (you operate the product) ———
# One GitHub App for ALL customers — each customer installs it on their org.

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./orvex-review.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=orvex-review
GITHUB_APP_BOT_LOGIN=orvex-review[bot]

# Public URL of your service (install callback + connect UI)
APP_URL=http://localhost:8787

# Signs ?state= on GitHub install redirect (use a long random string)
PLATFORM_SECRET=

# ——— User login (dashboard / connect flow) ———
# "Client ID" + "Client secret" from the same GitHub App's settings page.
# Set the app's Callback URL to {APP_URL}/auth/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Local dev only: skip OAuth and sign everyone in as a fake "dev" user.
# AUTH_DISABLED=1

# Optional: legacy single-repo dev mode (skip for SaaS)
# GITHUB_ALLOWED_REPO=Velatrixcloud/Velatrix-Cloud

# ——— LLM (platform keys — you bill customers) ———
# Configure ONE provider. MiniMax (OpenAI-compatible) wins when both are set.
# Option A: MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
# Option B: Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Future multi-model (not wired yet):
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=

# ——— Server ———
PORT=8787
HOST=0.0.0.0

# Queue: memory (default) or redis
QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Multi-tenant database (tenants, installations, PR state)
STORE_PATH=./.data/orvex-review.db

# Review limits
MAX_FILE_BYTES=120000
MAX_FILES=40
MAX_LLM_TOKENS=50000

CHECK_RUNS_ENABLED=0
SEMGREP_DISABLED=0

# Protect POST /review
REVIEW_API_SECRET=
