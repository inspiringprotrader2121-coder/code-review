# --- Storage, queue, and operations ---
# Production uses durable storage outside the checkout and Redis with a namespaced queue. deploy-safe never modifies the immutable server environment file.
# SQLite path. The relative example is local development only; production must use /home/orvex/orvex-data/velatrix-review.db or another absolute external path.
# Type: path. Range/default: absolute outside checkout in production. Redaction: path.
STORE_PATH=./.data/orvex-review.db
# Require an absolute durable database path outside the checkout.
# Type: boolean. Range/default: 1 enables; production enables automatically. Redaction: none.
# ORVEX_REQUIRE_DURABLE_STORAGE=1
# Stable worker identity suffix for durable ownership/leases.
# Type: string. Range/default: worker identity; default process PID. Redaction: none.
# ORVEX_WORKER_ID=
# Root under which temporary review checkouts may be created.
# Type: path. Range/default: absolute or relative root; default current directory. Redaction: path.
# ORVEX_CHECKOUT_ROOT=
# Queue implementation. Production requires Redis unless explicitly allowed for an emergency local case.
# Type: enum. Range/default: memory or redis; production defaults redis. Redaction: none.
QUEUE_BACKEND=memory
# Redis connection URL. It may contain credentials and is redacted in documentation/logs.
# Type: URL. Range/default: Redis connection URL. Redaction: connection.
REDIS_URL=redis://127.0.0.1:6379
# Explicit emergency allowance for memory queue in production. Avoid in normal deployments.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_ALLOW_MEMORY_QUEUE=1
# Namespace for queue keys on shared Redis. Tests use a unique namespace and never FLUSHDB.
# Type: string. Range/default: Redis key prefix; default orvex-review. Redaction: none.
ORVEX_QUEUE_NAMESPACE=orvex-review
# In-memory development queue deduplication bound.
# Type: integer. Range/default: 1..1000000; default 20000. Redaction: none.
ORVEX_QUEUE_MAX_DEDUP=20000
# Orphan review resume cap. Keep zero until durable per-stage checkpoints exist.
# Type: integer. Range/default: 0..10; default 0. Redaction: none.
ORVEX_MAX_RESUME_AFTER_RESTART=0
# Automatic whole-review retry count. Keep zero because a failed ensemble can already have incurred most of its cost.
# Type: integer. Range/default: 0..1; default 0. Redaction: none.
ORVEX_MAX_JOB_RETRIES=0
# Bounded provider-slot wait. Saturation fails transiently after this interval instead of holding every worker indefinitely.
# Type: integer. Range/default: 1000..3600000 ms; default 30000. Redaction: none.
ORVEX_PROVIDER_LEASE_WAIT_MS=30000
# Graceful shutdown drain. It must exceed ORVEX_LLM_MAX_TOTAL_MS to avoid mid-flight requeues.
# Type: integer. Range/default: 1000..86400000 ms; default 240000. Redaction: none.
ORVEX_SHUTDOWN_DRAIN_MS=960000
# Graceful shutdown cancellation grace period.
# Type: integer. Range/default: 100..60000 ms; default 10000. Redaction: none.
# ORVEX_SHUTDOWN_CANCEL_MS=10000
# Authoritative whole-review concurrency ceiling.
# Type: integer. Range/default: 1..100; default 8. Redaction: none.
ORVEX_MAX_CONCURRENT_REVIEWS=8
# API-key-authenticated Codex/Luna concurrency cap. It cannot raise the whole-review limit.
# Type: integer. Range/default: 1..32; default worker concurrency. Redaction: none.
ORVEX_CODEX_APIKEY_CONCURRENCY=8
# Luna provider-stage concurrency cap.
# Type: integer. Range/default: 1..32; default applicable worker/Codex limit. Redaction: none.
ORVEX_PROVIDER_CONCURRENCY_LUNA=8
# DeepSeek provider-stage concurrency cap. The eight-review production profile uses 24 for two discovery stages plus verification.
# Type: integer. Range/default: 1..32; default applicable worker/Codex limit. Redaction: none.
ORVEX_PROVIDER_CONCURRENCY_DEEPSEEK=24
# MiniMax provider-stage concurrency cap.
# Type: integer. Range/default: 1..32; default applicable worker/Codex limit. Redaction: none.
ORVEX_PROVIDER_CONCURRENCY_MINIMAX=8
# Monthly spend circuit breaker for non-custom plans.
# Type: number. Range/default: positive USD; default 250. Redaction: none.
ORVEX_MONTHLY_COGS_CAP_USD=250
# Durable heartbeat staleness threshold before startup recovery interrupts a row.
# Type: integer. Range/default: 60000..86400000 ms; default 900000. Redaction: none.
ORVEX_RUNNING_STALE_MS=900000
# Review-lease renewal cadence. Keep it well below the queue lease TTL.
# Type: integer. Range/default: 10000..300000 ms; default 300000. Redaction: none.
ORVEX_LEASE_RENEW_MS=300000
# Maximum compressed agent checkout size accepted before extraction.
# Type: integer. Range/default: positive bytes. Redaction: none.
ORVEX_AGENT_ARCHIVE_MAX_BYTES=150000000
# Daily free-tier review admission cap.
# Type: integer. Range/default: 0..1000000; default 300. Redaction: none.
# ORVEX_FREE_TIER_DAILY_CAP=300
# Reserved review cost used by admission before provider work begins.
# Type: number. Range/default: positive USD; default 5. Redaction: none.
# ORVEX_COGS_RESERVATION_USD=5
# Codex authentication status file used by readiness reporting.
# Type: path. Range/default: status path. Redaction: path.
# ORVEX_CODEX_STATUS_FILE=/home/orvex/orvex-data/codex-auth-status
# Deployment drain-marker file outside the checkout.
# Type: path. Range/default: drain marker path. Redaction: path.
# ORVEX_DEPLOY_DRAIN_PATH=/home/orvex/orvex-data/deploy-drain
# Optional disk path for operational monitoring.
# Type: path. Range/default: optional monitored path. Redaction: path.
# ORVEX_MONITOR_DISK_PATH=
# Operator-owned alert webhook for queue, billing, and database failures.
# Type: URL. Range/default: operator webhook URL. Redaction: connection.
ORVEX_ALERT_WEBHOOK_URL=

# --- Review execution and prompt budgets ---
# Limits bound time, spend, and context. Production verification remains on; max reasoning is enforced for Luna and DeepSeek.
# Legacy per-file review limit.
# Type: integer. Range/default: positive bytes. Redaction: none.
MAX_FILE_BYTES=300000
# Legacy maximum changed-file count.
# Type: integer. Range/default: positive files. Redaction: none.
MAX_FILES=150
# Legacy LLM token ceiling.
# Type: integer. Range/default: positive tokens. Redaction: none.
MAX_LLM_TOKENS=50000
# Per-call timeout protecting the per-PR lock from hung calls.
# Type: integer. Range/default: 1000..900000 ms; default 240000. Redaction: none.
# ORVEX_LLM_TIMEOUT_MS=240000
# Responses API hard timeout.
# Type: integer. Range/default: 1000..900000 ms; default 900000. Redaction: none.
# ORVEX_RESPONSES_TIMEOUT_MS=900000
# Shorten timeout bounds only in tests.
# Type: boolean. Range/default: test-only flag. Redaction: none.
# ORVEX_TEST_SHORT_TIMEOUTS=1
# Maximum LLM output token request.
# Type: integer. Range/default: positive tokens; default 64000. Redaction: none.
# ORVEX_MAX_OUTPUT_TOKENS=64000
# Hard cap for maximum LLM output tokens.
# Type: integer. Range/default: 1..1000000; default 64000. Redaction: none.
# ORVEX_MAX_OUTPUT_TOKENS_CAP=64000
# Maximum findings retained per review pass.
# Type: integer. Range/default: 1..1000; default 25. Redaction: none.
# ORVEX_MAX_FINDINGS=25
# Agent review context budget.
# Type: integer. Range/default: 1..2000000 chars; default 240000. Redaction: none.
# ORVEX_AGENT_CTX_CHARS=240000
# Manual review command trigger.
# Type: string. Range/default: GitHub comment trigger; default @orvex. Redaction: none.
# ORVEX_TRIGGER=@orvex
# Disable inline evidence gating only for controlled experimentation.
# Type: boolean. Range/default: 0 disables; default enabled. Redaction: none.
# ORVEX_INLINE_EVIDENCE_GATE=0
# Feed repository tree and imported files to the model.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_DEEP_CONTEXT=1
# Optional additive Flash risk hunt for high-risk diffs. Normal plans retain their advertised reviewer count when unset.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_RISK_HUNT=1
# Enable the optional high-tier investigation pass after fixed public-plan reviewers are scheduled.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_INVESTIGATE=1
# Explicit provider slot for the optional investigation pass; it never changes public-plan routing.
# Type: enum. Range/default: deepseek-flash, deepseek, openai, or standard; default deepseek-flash. Redaction: none.
# ORVEX_INVESTIGATE_TIER=deepseek-flash
# Skeptical final verification stage. Production does not permit disabling it.
# Type: boolean. Range/default: 0 disables only locally; production always enables. Redaction: none.
# ORVEX_VERIFY=1
# Verifier per-file context budget.
# Type: integer. Range/default: positive chars; default 32000. Redaction: none.
# ORVEX_VERIFY_FILE_CHARS=32000
# Verifier total context budget.
# Type: integer. Range/default: positive chars; default 96000. Redaction: none.
# ORVEX_VERIFY_TOTAL_CHARS=96000
# Verifier candidate batch size.
# Type: integer. Range/default: positive; default 3. Redaction: none.
# ORVEX_VERIFY_BATCH_SIZE=3
# Verifier batch concurrency. The production profile uses one per review to keep total DeepSeek fan-out bounded.
# Type: integer. Range/default: 1..8; default 3. Redaction: none.
# ORVEX_VERIFY_CONCURRENCY=1
# Optional number of additional risk probes.
# Type: integer. Range/default: 0..4; unset disables. Redaction: none.
# ORVEX_RISK_PROBES=
# Risk-probe selection threshold.
# Type: number. Range/default: >=1.5; default 2. Redaction: none.
# ORVEX_RISK_PROBE_SELECTIVITY=2
# Changed-file count classifying a large PR.
# Type: integer. Range/default: positive; default 40. Redaction: none.
# ORVEX_LARGE_PR_FILES=40
# Patch size classifying a large PR.
# Type: integer. Range/default: positive chars; default 150000. Redaction: none.
# ORVEX_LARGE_PR_PATCH_CHARS=150000
# Condition selecting breadth/removed-behaviour review lenses.
# Type: string. Range/default: review breadth mode; default deep-or-large. Redaction: none.
# ORVEX_BREADTH_ON=deep-or-large
# Maximum investigation-tool steps.
# Type: integer. Range/default: 1..20; default 8. Redaction: none.
# ORVEX_INVESTIGATE_MAX_STEPS=8
# Investigation-tool output budget.
# Type: integer. Range/default: 2000..80000 chars; default 24000. Redaction: none.
# ORVEX_INVESTIGATE_TOOL_CHARS=24000
# Largest file eligible for investigation.
# Type: integer. Range/default: positive bytes; default 250000. Redaction: none.
# ORVEX_INVESTIGATE_FILE_BYTES=250000
# Repeated-review aggregation count. Enable 5-10 only after measuring the pinned evaluation corpus.
# Type: integer. Range/default: 1 or measured 5..10 samples; default 1. Redaction: none.
ORVEX_REVIEW_AGGREGATION_RUNS=1
# Minimum repeated-run recurrence before a finding is kept.
# Type: integer. Range/default: positive; default 2. Redaction: none.
ORVEX_REVIEW_AGGREGATION_MIN_OCCURRENCES=2
# Repeated-run sampling temperature.
# Type: number. Range/default: 0..1; default 0.2. Redaction: none.
ORVEX_REVIEW_AGGREGATION_TEMPERATURE=0.2
# Maximum candidates sent to aggregation.
# Type: integer. Range/default: 10..250; default 120. Redaction: none.
ORVEX_REVIEW_AGGREGATION_MAX_CANDIDATES=120
# Lifetime inline-comment cap per PR; remaining findings go to the summary.
# Type: integer. Range/default: positive comments. Redaction: none.
# ORVEX_MAX_INLINE_PER_PR=20
# Maximum summary-only comments for findings without a safe diff anchor.
# Type: integer. Range/default: 0..50; default 3. Redaction: none.
# ORVEX_MAX_UNANCHORED_COMMENTS=3
# Durable review-run ownership heartbeat cadence. GitHub PR-state fallback polling is never more frequent than every 30 seconds.
# Type: integer. Range/default: 1000..900000 ms; default 5000. Redaction: none.
# ORVEX_ABORT_POLL_MS=5000
# Hard per-review provider-call budget including optional work.
# Type: integer. Range/default: 1..100; default 28. Redaction: none.
# ORVEX_REVIEW_MAX_CALLS=28
# Maximum concurrent stages inside one review after provider admission.
# Type: integer. Range/default: 1..64; default 3. Redaction: none.
# ORVEX_REVIEW_CONCURRENCY=3
# Per-file context cap for optional repository sweeps.
# Type: integer. Range/default: 1..200000 chars; default 10000. Redaction: none.
# ORVEX_SWEEP_FILE_CHARS=10000
# Duplicate-review cooldown per pull-request head.
# Type: integer. Range/default: 0..86400 seconds; default 120. Redaction: none.
# ORVEX_REVIEW_COOLDOWN_S=120
# Use GitHub REQUEST_CHANGES for open P1 findings.
# Type: boolean. Range/default: 1 enables; default advisory. Redaction: none.
# ORVEX_REQUEST_CHANGES=1
# Fail the GitHub check run when P1 findings remain open.
# Type: boolean. Range/default: 1 enables; default advisory. Redaction: none.
# ORVEX_FAIL_CHECK_ON_P1=1
# Enable GitHub check-run publishing.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
CHECK_RUNS_ENABLED=0
# Disable Semgrep integration.
# Type: boolean. Range/default: 1 disables; default enabled. Redaction: none.
SEMGREP_DISABLED=0
# Protects POST /review. Do not reuse as an admin secret.
# Type: string. Range/default: random bearer secret. Redaction: secret.
REVIEW_API_SECRET=
# Separate credential for privileged plan and super-admin automation. There is no PLATFORM_SECRET fallback.
# Type: string. Range/default: random bearer secret. Redaction: secret.
ORVEX_ADMIN_SECRET=
# Enable scheduled nightly scanning.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
# ORVEX_NIGHTLY_SCANS=1
# Nightly scan lookback period.
# Type: integer. Range/default: 1..30; default 1. Redaction: none.
# ORVEX_NIGHTLY_LOOKBACK_DAYS=1
# Nightly scan hour.
# Type: integer. Range/default: 0..23; default 3. Redaction: none.
# ORVEX_NIGHTLY_HOUR=3
# Maximum nightly scans per tenant/day.
# Type: integer. Range/default: 1..500; default 25. Redaction: none.
# ORVEX_NIGHTLY_MAX_SCANS_PER_TENANT=25
# Autofix command rate cap.
# Type: integer. Range/default: 1..10000; default 60. Redaction: none.
# ORVEX_COMMANDS_PER_HOUR=60
# Maximum autofix runs per day.
# Type: integer. Range/default: 1..10000; default 30. Redaction: none.
# ORVEX_MAX_FIX_RUNS_PER_DAY=30
# Maximum autofix targets per run.
# Type: integer. Range/default: 1..500; default 25. Redaction: none.
# ORVEX_MAX_FIX_TARGETS=25
# Autofix source-file context cap.
# Type: integer. Range/default: 1..10000; default 100. Redaction: none.
# ORVEX_CTX_SOURCE=100
# Autofix related-file context cap.
# Type: integer. Range/default: 0..10000; default 30. Redaction: none.
# ORVEX_CTX_RELATED=30
# Autofix dependent-file context cap.
# Type: integer. Range/default: 0..10000; default 20. Redaction: none.
# ORVEX_CTX_DEPENDENTS=20
# Autofix per-file context byte cap.
# Type: integer. Range/default: 1..10000000 bytes; default 32000. Redaction: none.
# ORVEX_CTX_FILE_BYTES=32000
# Autofix other-file context cap.
# Type: integer. Range/default: 0..10000; default 20. Redaction: none.
# ORVEX_CTX_OTHERS=20

# --- Codex CLI and sandbox ---
# Agentic Luna execution is restricted to named trusted repositories, API-key authentication, and the internal runtime boundary. The code pins model and maximum reasoning effort.
# Enable the restricted Codex CLI agentic pass.
# Type: boolean. Range/default: 1 enables; default disabled. Redaction: none.
ORVEX_CODEX_CLI=0
# Trusted repositories allowed to run the Codex CLI. Wildcards are refused.
# Type: csv. Range/default: explicit owner/repo names. Redaction: none.
ORVEX_CODEX_CLI_REPOS=
# Dedicated API-key Codex home. OAuth homes are refused in production.
# Type: path. Range/default: API-key-authenticated home. Redaction: path.
# ORVEX_CODEX_HOME=/home/orvex/.codex-apikey
# Optional bounded set of dedicated Codex homes.
# Type: csv-paths. Range/default: dedicated Codex homes. Redaction: path.
# ORVEX_CODEX_HOMES=
# Optional bounded set of approved Codex proxies.
# Type: csv-URLs. Range/default: approved proxies. Redaction: connection.
# ORVEX_CODEX_PROXIES=
# Single approved Codex proxy compatibility setting.
# Type: URL. Range/default: approved proxy URL. Redaction: connection.
# ORVEX_CODEX_PROXY=
# Pinned local Codex CLI executable. Unpinned global binaries are refused.
# Type: path. Range/default: pinned project-local CLI path. Redaction: path.
# ORVEX_CODEX_CLI_PATH=
# Wall-clock cap for one agentic pass.
# Type: integer. Range/default: 60000..480000 ms; default 480000. Redaction: none.
ORVEX_CODEX_TIMEOUT_MS=480000
# Stdout/stderr silence cap for one agentic pass.
# Type: integer. Range/default: 30000..ORVEX_CODEX_TIMEOUT_MS; default 300000. Redaction: none.
ORVEX_CODEX_INACTIVITY_TIMEOUT_MS=300000
# Codex rate-limit retry maximum wait.
# Type: integer. Range/default: milliseconds; default 60000. Redaction: none.
# ORVEX_CODEX_RATELIMIT_MAX_WAIT_MS=60000
# Codex rate-limit total sleep budget.
# Type: integer. Range/default: milliseconds; default 60000. Redaction: none.
ORVEX_CODEX_RATELIMIT_TOTAL_WAIT_MS=60000
# Conservative input-token floor for Codex usage accounting.
# Type: integer. Range/default: positive tokens; default 50000. Redaction: none.
# ORVEX_CODEX_USAGE_FLOOR_INPUT=50000
# Conservative output-token floor for Codex usage accounting.
# Type: integer. Range/default: positive tokens; default 5000. Redaction: none.
# ORVEX_CODEX_USAGE_FLOOR_OUTPUT=5000
# Codex opening-turn diff budget.
# Type: integer. Range/default: positive chars; default 60000. Redaction: none.
# ORVEX_CODEX_MAX_DIFF_CHARS=60000
# Codex opening-turn prompt budget.
# Type: integer. Range/default: positive chars; default 100000. Redaction: none.
# ORVEX_CODEX_MAX_PROMPT_CHARS=100000
# Codex repository-tree path budget.
# Type: integer. Range/default: positive; default 400. Redaction: none.
# ORVEX_CODEX_MAX_TREE_PATHS=400
# Slim retry diff budget after a request-too-large error.
# Type: integer. Range/default: positive chars; default 30000. Redaction: none.
# ORVEX_CODEX_SLIM_DIFF_CHARS=30000
# Slim retry prompt budget after a request-too-large error.
# Type: integer. Range/default: positive chars; default 50000. Redaction: none.
# ORVEX_CODEX_SLIM_PROMPT_CHARS=50000
# Per-container /work disk budget checked after install and between steps.
# Type: integer. Range/default: positive bytes; default 1 GiB; maximum 2 GiB. Redaction: none.
# ORVEX_SANDBOX_WORKDIR_MAX_BYTES=1073741824
# Maximum wait for an internal sandbox slot.
# Type: integer. Range/default: milliseconds; default 600000. Redaction: none.
# ORVEX_SANDBOX_SLOT_WAIT_MS=600000
# Maximum duration of one internal runtime-verification step.
# Type: integer. Range/default: positive milliseconds; default 240000; maximum 900000. Redaction: none.
# ORVEX_SANDBOX_STEP_TIMEOUT_MS=240000
# Maximum dependency-install duration in an internal runtime-verification sandbox.
# Type: integer. Range/default: positive milliseconds; default 600000; maximum 900000. Redaction: none.
# ORVEX_SANDBOX_INSTALL_TIMEOUT_MS=600000
# Rootless Docker socket for the internal runtime sandbox. Never use a rootful socket or remote Docker context.
# Type: URL. Range/default: rootless local Unix socket only. Redaction: connection.
# DOCKER_HOST=unix:///run/user/<orvex-uid>/docker.sock
# Optional Docker context for the internal sandbox. Keep it unset unless the rootless local context is explicitly required.
# Type: string. Range/default: local rootless Docker context only; default unset. Redaction: connection.
# DOCKER_CONTEXT=
# Enable runtime execution only after the rootless-host preflight passes.
# Type: boolean. Range/default: 1 enables after preflight; default disabled. Redaction: none.
# ORVEX_CODE_EXECUTION=0
# Run agentic Codex only inside the rootless internal sandbox with the dedicated egress broker.
# Type: boolean. Range/default: 1 enables after internal egress preflight; default disabled. Redaction: none.
# ORVEX_CODEX_CONTAINER_RUNTIME=0
# Host-wide maximum concurrent internal sandbox containers.
# Type: integer. Range/default: positive; default 8; maximum 8. Redaction: none.
# ORVEX_MAX_SANDBOXES=8
# Host-wide atomic sandbox-slot lease directory. Keep it outside the deployed checkout.
# Type: path. Range/default: absolute private service-owned directory; default system temporary directory. Redaction: path.
# ORVEX_SANDBOX_SLOT_DIR=/home/orvex/orvex-data/sandbox-slots
# Grace period used when reclaiming a sandbox slot whose owning process is no longer alive.
# Type: integer. Range/default: positive milliseconds; default 600000; maximum 3600000. Redaction: none.
# ORVEX_SANDBOX_SLOT_STALE_MS=600000
# Mandatory immutable internal sandbox image. It must be preloaded into the rootless daemon.
# Type: image digest. Range/default: locally loaded immutable digest. Redaction: none.
# ORVEX_SANDBOX_IMAGE=sha256:<64-hex-local-image-id>
# Mandatory immutable image for the internal Codex-to-OpenAI egress broker when container runtime is enabled.
# Type: image digest. Range/default: locally loaded immutable digest. Redaction: none.
# ORVEX_CODEX_EGRESS_BROKER_IMAGE=sha256:<64-hex-local-image-id>

# --- Retries and focused prompt limits ---
# These values bound retry delays and supporting context. The diff remains first and is fairly sampled only on oversized PRs.
# Maximum recoverable provider rate-limit retry rounds.
# Type: integer. Range/default: non-negative; default 2. Redaction: none.
ORVEX_RATELIMIT_MAX_RETRIES=2
# Maximum per-rate-limit retry sleep.
# Type: integer. Range/default: milliseconds; default 60000. Redaction: none.
ORVEX_RATELIMIT_MAX_WAIT_MS=60000
# Base retry-backoff duration.
# Type: integer. Range/default: milliseconds; default 2000. Redaction: none.
# ORVEX_RATELIMIT_BASE_MS=2000
# Total retry sleep budget per provider call.
# Type: integer. Range/default: milliseconds; default 60000. Redaction: none.
ORVEX_RATELIMIT_TOTAL_WAIT_MS=60000
# Primary diff context budget.
# Type: integer. Range/default: positive chars; default 96000. Redaction: none.
ORVEX_MAX_DIFF_CHARS=96000
# Changed-file supporting context budget.
# Type: integer. Range/default: positive chars; default 64000. Redaction: none.
ORVEX_MAX_CHANGED_CHARS=64000
# Related-file context budget.
# Type: integer. Range/default: positive chars; default 24000. Redaction: none.
ORVEX_MAX_RELATED_CHARS=24000
# Other supporting context budget.
# Type: integer. Range/default: positive chars; default 8000. Redaction: none.
ORVEX_MAX_OTHER_CHARS=8000
# Repository-tree path budget.
# Type: integer. Range/default: positive paths; default 400. Redaction: none.
ORVEX_MAX_TREE_PATHS=400
# Full changed-file context budget.
# Type: integer. Range/default: positive chars; default 12000. Redaction: none.
# ORVEX_FULL_CHANGED_FILE_CHARS=12000
# Changed-line surrounding context.
# Type: integer. Range/default: positive lines; default 32. Redaction: none.
# ORVEX_CHANGED_CONTEXT_LINES=32
# Changed chunks retained per file.
# Type: integer. Range/default: positive chunks; default 4. Redaction: none.
# ORVEX_MAX_CHANGED_CHUNKS_PER_FILE=4
# Changed chunk length budget.
# Type: integer. Range/default: positive chars; default 12000. Redaction: none.
# ORVEX_MAX_CHANGED_CHUNK_CHARS=12000
# DeepSeek completion token cap while maintaining maximum reasoning effort.
# Type: integer. Range/default: positive tokens. Redaction: none.
ORVEX_DEEPSEEK_MAX_OUTPUT_TOKENS=24000
# MiniMax completion token cap.
# Type: integer. Range/default: positive tokens. Redaction: none.
ORVEX_MINIMAX_MAX_OUTPUT_TOKENS=24000
