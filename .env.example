# ——— Platform (you operate the product) ———
# One GitHub App for ALL customers — each customer installs it on their org.

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./orvex-review.pem
GITHUB_WEBHOOK_SECRET=
# How long a processed GitHub body-hash claim blocks rotated-delivery-id replays
# of the same signed payload (default 2h). Delivery-id dedupe remains permanent
# until normal webhook_events retention.
# ORVEX_WEBHOOK_BODY_DEDUP_TTL_MS=7200000
GITHUB_APP_SLUG=orvex-review
GITHUB_APP_BOT_LOGIN=orvex-review[bot]

# Public URL of your service (install callback + connect UI)
APP_URL=http://localhost:8787

# Comma-separated workspace slugs allowed to view internal LLM spend. Leave
# empty to hide LLM costs from every tenant dashboard and tenant API response.
ORVEX_LLM_COST_VISIBLE_TENANTS=

# Signs ?state= on GitHub install redirect (use a long random string)
PLATFORM_SECRET=

# ——— User login (dashboard / connect flow) ———
# "Client ID" + "Client secret" from the same GitHub App's settings page.
# Set the app's Callback URL to {APP_URL}/auth/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Create a Web application client in Google Auth Platform. Set its redirect URI
# to {APP_URL}/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local dev only: skip OAuth and sign everyone in as a fake "dev" user.
# AUTH_DISABLED=1

# ——— Stripe billing ———
# Account: Orvex (acct_1T5JZd8PXLhHNy0D)
# API keys: https://dashboard.stripe.com/acct_1T5JZd8PXLhHNy0D/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe recurring price IDs per plan (create in the Stripe dashboard).
# Starter ($29/mo, 100 included, then $0.50 prepaid overage; hard ceiling 1000):
STRIPE_PRICE_REVIEW=
# Pro ($69/mo, 500/mo hard, no prepaid overage):
STRIPE_PRICE_REVIEW_PLUS=
# Verify Lite ($49/mo, 50 included, then $0.75 prepaid; hard ceiling 500):
STRIPE_PRICE_VERIFY_LITE=
# Verify ($99/mo, 120 included, then $0.75 prepaid; hard ceiling 1000):
STRIPE_PRICE_VERIFY=
# Prepaid credit pack sizes in USD cents (dashboard Buy credits):
ORVEX_CREDIT_PACKS_CENTS=1000,2500,5000,10000
# Legacy metered Stripe meters are unused (prepaid wallet replaced postpaid overage).
# STRIPE_METER_EVENT_REVIEW=orvex_review_overage
# STRIPE_METER_EVENT_VERIFY_LITE=orvex_verify_lite_overage
# STRIPE_METER_EVENT_VERIFY=orvex_verify_overage

# Optional: legacy single-repo dev mode (skip for SaaS)
# GITHUB_ALLOWED_REPO=Velatrixcloud/Velatrix-Cloud

# ——— LLM (platform keys — you bill customers) ———
# Normal plans require MiniMax plus DeepSeek v4 Flash. Verify-tier plans also
# require API-key-authenticated Luna through the pinned project-local Codex CLI.
# MiniMax uses its official Anthropic-compatible streaming API so reasoning
# blocks are preserved.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API=anthropic
# Active standard reviewer target used by all current plans.
ORVEX_STANDARD_API_KEY=
ORVEX_STANDARD_BASE_URL=https://api.minimax.io/anthropic
ORVEX_STANDARD_MODEL=MiniMax-M3
ORVEX_STANDARD_API=anthropic
# One provider attempt is hard-capped at five minutes; hard timeouts are not retried.
ORVEX_LLM_MAX_TOTAL_MS=300000
ORVEX_ANTHROPIC_THINKING_BUDGET_TOKENS=20000
# DeepSeek — REQUIRED: Flash runs pass 2 on dual-model plans, passes 2 and 3 on
# multi-model plans, and the separate verification stage. Missing Flash fails
# closed rather than silently substituting a different model.
# ORVEX_DEEPSEEK_API_KEY=
# ORVEX_DEEPSEEK_MODEL=deepseek-v4-pro
# ORVEX_DEEPSEEK_EFFORT=max

# Native OpenAI credentials. Production high-tier Luna runs only through the
# pinned Codex CLI using API-key auth; direct Responses configuration is kept
# for explicit diagnostics/evaluation and never substitutes for the CLI stage.
ORVEX_OPENAI_API_KEY=
ORVEX_OPENAI_BASE_URL=https://api.openai.com/v1
ORVEX_OPENAI_MODEL=gpt-5.6-luna
ORVEX_OPENAI_API=responses
ORVEX_OPENAI_REASONING_EFFORT=max
# Cost metering ($ per 1M tokens) for OpenAI-tier usage rows. The code defaults
# below MUST track the provider's current pricing — verification usage is now
# attributed to this tier, so a stale value under/over-reports real spend.
ORVEX_OPENAI_COST_INPUT_PER_M=0.2
ORVEX_OPENAI_COST_OUTPUT_PER_M=1.2

# Future multi-model (not wired yet):
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=

# ——— Server ———
PORT=8787
HOST=0.0.0.0

# Queue: memory (default) or redis
QUEUE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379

# Multi-tenant database (tenants, installations, PR state)
# This relative path is for local development only. Production PM2 forces
# durable-storage mode and must use an absolute path outside the checkout.
# Production example: /home/orvex/orvex-data/velatrix-review.db
STORE_PATH=./.data/orvex-review.db

# Review limits
MAX_FILE_BYTES=300000
MAX_FILES=150
MAX_LLM_TOKENS=50000

# Deep review: feed repo tree + imported files to the model (0 to disable)
# ORVEX_DEEP_CONTEXT=1
# Optional additive Flash risk-hunt on high-risk diffs. Normal plan runs leave
# this unset so their advertised two/four reviewer count stays exact.
# ORVEX_RISK_HUNT=1
# Review reasoning is enforced in code. Luna and DeepSeek run at max effort;
# MiniMax thinking is enabled. These cannot be weakened by live env drift.
# Adversarial verification: a skeptical final stage refutes findings/fixes.
# Production always verifies; ORVEX_VERIFY=0 is available only for local tests.
# ORVEX_VERIFY=1
# Cumulative inline comments per PR across its lifetime (rest go to the summary)
# ORVEX_MAX_INLINE_PER_PR=20
# Per-LLM-call timeout (ms); prevents hung jobs holding the per-PR fix lock
# ORVEX_LLM_TIMEOUT_MS=240000
# Repeated-run aggregation is OFF by default. Enable only after measuring the
# pinned evaluation corpus: 5-10 complete independent samples, then require a
# finding in at least two samples. If the model-call budget cannot fund five
# complete samples alongside required sweep work, Orvex safely uses one review.
ORVEX_REVIEW_AGGREGATION_RUNS=1
ORVEX_REVIEW_AGGREGATION_MIN_OCCURRENCES=2
ORVEX_REVIEW_AGGREGATION_TEMPERATURE=0.2
ORVEX_REVIEW_AGGREGATION_MAX_CANDIDATES=120
# Gating (off by default — Orvex is advisory):
# ORVEX_REQUEST_CHANGES=1     # use REQUEST_CHANGES on P1 findings
# ORVEX_FAIL_CHECK_ON_P1=1    # fail the check run when P1s are open

CHECK_RUNS_ENABLED=0
SEMGREP_DISABLED=0

# Protect POST /review
REVIEW_API_SECRET=
# Separate credential for privileged plan and super-admin routes. Do not reuse
# REVIEW_API_SECRET, which can trigger arbitrary review work. Required for
# bearer admin automation — there is no PLATFORM_SECRET fallback.
ORVEX_ADMIN_SECRET=
# Optional operator-owned webhook for queue, billing, and database alerts.
ORVEX_ALERT_WEBHOOK_URL=

# ——— Operational limits that MUST agree with each other ———
# Graceful-shutdown drain. MUST exceed ORVEX_LLM_MAX_TOTAL_MS, or a deploy during
# a review force-requeues it mid-flight (it was 240s against a 900s call cap).
ORVEX_SHUTDOWN_DRAIN_MS=960000
# Provider-specific call ceilings. Redis-backed production coordinates these
# across worker processes as well as in-process. Keep all five capacity values
# equal for an eight-review API-key pool. ORVEX_MAX_CONCURRENT_REVIEWS remains
# the authoritative whole-review ceiling; Codex and provider values only cap
# their own stages and never raise the worker limit.
# This file is a reference template: deploy-safe intentionally never overwrites
# the immutable production .env, so changing these lines alone does not alter a
# running server.
ORVEX_MAX_CONCURRENT_REVIEWS=8
ORVEX_CODEX_APIKEY_CONCURRENCY=8
ORVEX_PROVIDER_CONCURRENCY_LUNA=8
ORVEX_PROVIDER_CONCURRENCY_DEEPSEEK=8
ORVEX_PROVIDER_CONCURRENCY_MINIMAX=8
# Zero/unset waits behind the distributed provider slot until it is available
# or the review is cancelled. A positive value opts into a bounded wait.
ORVEX_PROVIDER_LEASE_WAIT_MS=0
# A complete failed ensemble can already have incurred most of its cost. Keep
# automatic whole-review replay off; a new push or explicit command can retry.
ORVEX_MAX_JOB_RETRIES=0
# A claimed review may already have spent across several stages before a crash.
# Keep orphan replay off until durable per-stage checkpoints exist.
ORVEX_MAX_RESUME_AFTER_RESTART=0
# Spend circuit breaker for non-custom plans.
ORVEX_MONTHLY_COGS_CAP_USD=250
# Startup recovery only interrupts rows whose durable heartbeat is stale. The
# code enforces a 60-second minimum so another live worker cannot be cleared.
ORVEX_RUNNING_STALE_MS=900000
# Reject oversized compressed agent checkouts before extraction.
ORVEX_AGENT_ARCHIVE_MAX_BYTES=150000000
# How often the worker heartbeats a job's in-flight lease. Must be well under the
# queue's lease TTL (900s) — a review that outlives the lease can be claimed by a
# second worker and reviewed twice (duplicate comments + double overage billing).
ORVEX_LEASE_RENEW_MS=300000

# ——— Codex CLI (agentic pass) — KEEP DISABLED unless you understand this ———
ORVEX_CODEX_CLI=0
# The runtime package and code pin gpt-5.6-luna at max effort. There are no model
# or effort env overrides: a rejected model fails closed and no substitute runs.
# SECURITY-CRITICAL. Codex uses its native read-only sandbox, ignores repository
# rules/user config, and receives a minimal environment. That is still not a
# credential-isolating container boundary, so the complete CLI invocation stays
# restricted to explicitly named trusted repositories. Wildcards are refused.
# Comma-separated "owner/repo", case-insensitive.
ORVEX_CODEX_CLI_REPOS=
# Dedicated CODEX_HOME for the worker (auth.json + sessions). Prefer a dedicated
# dir so interactive `codex` login on the same machine cannot clobber production.
# ORVEX_CODEX_HOME=/home/orvex/.codex-apikey
# OAuth homes are refused in production. Luna requires an API-key-authenticated
# home; independent API-key sessions use the bounded concurrency configured above.
# Wall-clock and stdout/stderr-silence caps for one agentic pass.
ORVEX_CODEX_TIMEOUT_MS=300000
ORVEX_CODEX_INACTIVITY_TIMEOUT_MS=180000
# Lean opening-turn budgets when a repo checkout exists (agent reads files from disk).
# ORVEX_CODEX_MAX_DIFF_CHARS=60000
# ORVEX_CODEX_MAX_PROMPT_CHARS=100000
# ORVEX_CODEX_MAX_TREE_PATHS=400
# After Request-too-large: one fresh-thread slim retry, never another model.
# ORVEX_CODEX_SLIM_DIFF_CHARS=30000
# ORVEX_CODEX_SLIM_PROMPT_CHARS=50000

# ——— Rate-limit handling ———
# A recoverable per-minute limit is WAITED OUT rather than failing the review.
ORVEX_RATELIMIT_MAX_RETRIES=2
ORVEX_RATELIMIT_MAX_WAIT_MS=60000
# Total sleep budget per call — bounds how long a worker slot can sit waiting.
ORVEX_RATELIMIT_TOTAL_WAIT_MS=60000
ORVEX_CODEX_RATELIMIT_TOTAL_WAIT_MS=60000

# Focused prompt budgets. Diff content stays first and is fairly sampled only on
# oversized PRs; the remaining limits cap supporting source and repo context.
ORVEX_MAX_DIFF_CHARS=96000
ORVEX_MAX_CHANGED_CHARS=64000
ORVEX_MAX_RELATED_CHARS=24000
ORVEX_MAX_OTHER_CHARS=8000
ORVEX_MAX_TREE_PATHS=400
# Keep maximum reasoning effort while bounding completion duration and spend.
ORVEX_DEEPSEEK_MAX_OUTPUT_TOKENS=24000
ORVEX_MINIMAX_MAX_OUTPUT_TOKENS=24000

# ——— DeepSeek v4 Flash (reviewer + fixed verifier) ———
# Rides the SAME key as v4 Pro — only the model id differs, so enabling it costs
# no new credential. Runs deep-dive and removed-behaviour/caller lenses on the
# higher tiers, plus the strict verifier. Every stage stays at max effort.
ORVEX_DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
ORVEX_DEEPSEEK_FLASH_EFFORT=max
# Priced separately so a Flash pass isn't billed at Pro rates.
# Verified against published pricing 2026-08-01 (standard, cache-miss).
ORVEX_DEEPSEEK_FLASH_COST_INPUT_PER_M=0.14
ORVEX_DEEPSEEK_FLASH_COST_OUTPUT_PER_M=0.28

# Sandbox (/work) disk budget for runtime verification. Checked after install and
# between steps; exceeding it fails the run. Default 4 GiB.
# ORVEX_SANDBOX_WORKDIR_MAX_BYTES=4294967296
# Max wait for a free sandbox slot before failing (default 10 minutes).
# ORVEX_SANDBOX_SLOT_WAIT_MS=600000
# Internal rootless Docker socket for runtime verification. Provision it first
# with scripts/provision-internal-sandbox.sh, then replace <orvex-uid> with the
# service account's numeric UID. Do not point this at the rootful Docker socket.
# DOCKER_HOST=unix:///run/user/<orvex-uid>/docker.sock
# Keep runtime execution off until its rootless-host preflight passes.
# ORVEX_CODE_EXECUTION=0
# Mandatory immutable runtime image. It must already be loaded into the rootless
# daemon and include the package-manager binaries/offline caches you approve.
# ORVEX_SANDBOX_IMAGE=sha256:<64-hex-local-image-id>

# ——— LLM pricing (USD per 1M tokens) — verified 2026-08-01 ———
# Standard short-context, cache-MISS rates. We bill full input at these and do
# not discount cache hits, so reported cost is conservative (over-reports).
# Long-context surcharges are not modelled: Luna doubles input above 272K,
# MiniMax above 512K. Focused review prompts remain below both thresholds.
ORVEX_COST_INPUT_PER_M=1.4                 # legacy premium route (env-priced)
ORVEX_COST_OUTPUT_PER_M=4.4
ORVEX_STANDARD_COST_INPUT_PER_M=0.3        # MiniMax-M3
ORVEX_STANDARD_COST_OUTPUT_PER_M=1.2
ORVEX_OPENAI_COST_INPUT_PER_M=0.2          # gpt-5.6-luna (post 2026-07-30 cut)
ORVEX_OPENAI_COST_OUTPUT_PER_M=1.2
ORVEX_DEEPSEEK_COST_INPUT_PER_M=0.435      # deepseek-v4-pro
ORVEX_DEEPSEEK_COST_OUTPUT_PER_M=0.87
